# Knightwatcher: the host paths, the bundled server's address and port, the admin password and the
# credentials. Copy
# to .env beside compose.yaml (ignored by git), fill in your own, and keep it to yourself:
# chmod 600 .env. Every value here is invented. docs/configuration.md describes each variable.
#
# One NAME=value a line, read by docker compose. A value holding $, #, a space or a quote goes in
# single quotes, such as 'pa$$ word#1', so that compose takes it exactly as written. Settings go
# in config.toml, never here.

# ---- Host paths ------------------------------------------------------------------------------
# compose.yaml mounts each into the collector's container, or the server's. Every path must
# already exist. A relative path is relative to compose.yaml.

# The folder the collector writes state.json to. Mounted at /out, and read-only at /out in the
# server, which serves it to the page as data/. Must be writable by the collector's account
# (uid 10001). Required.
# Possible values: a folder, absolute or relative to compose.yaml, such as ./var/out, or
# /srv/www/knightwatcher/data when a web server of your own serves the page.
KNIGHTWATCHER_OUT=./var/out

# The host's backup log, a single file, for [sources.backup]. Mounted read-only at
# /host/backup.log. Required.
# Possible values: an absolute file, such as /var/log/backup.log.
KNIGHTWATCHER_BACKUP_LOG=/var/log/backup.log

# Any folder on the data volume, so that [sources.host] can see the volume's size. Mounted
# read-only at /host/disks/data. An empty folder shares nothing but the size. Required.
# Possible values: an absolute folder, such as /data/lost+found.
KNIGHTWATCHER_DATA_DISK=/data/lost+found

# The folder for the collector's memory between restarts. Mounted at /var/lib/knightwatcher.
# Must be writable by the collector's account. Optional: left out, it is ./var beside
# compose.yaml.
# Possible values: a folder, absolute or relative to compose.yaml, such as ./var.
KNIGHTWATCHER_VAR=./var

# The folder of provider files of your own, for services no built-in provider reads (see
# docs/providers.md). Mounted read-only at /etc/knightwatcher/providers in both containers. Must
# be readable by uid 10001. Optional: left out, it is ./providers beside compose.yaml, which the
# repository ships empty.
# Possible values: a folder, absolute or relative to compose.yaml, such as ./providers.
KNIGHTWATCHER_PROVIDERS=./providers

# The bundled server's own folder, where it keeps the settings saved for every display
# (settings.json), those set on the admin page (admin.json) and its sessions. Mounted at
# /var/lib/knightwatcher-server, the one place the server writes, and read-only in the collector.
# Must be writable by the server's account (uid 10001). Optional: left out, it is ./var/server
# beside compose.yaml.
# Possible values: a folder, absolute or relative to compose.yaml, such as ./var/server.
KNIGHTWATCHER_SERVER_VAR=./var/server

# ---- The bundled server ----------------------------------------------------------------------
# Where compose.yaml publishes the server on the host. The walls are open to anyone who can reach
# that address, with no login: never publish it to the internet without one in front. See
# docs/server.md.

# The host address to publish it on. Optional: left empty, it is all of the host's addresses,
# IPv4 and IPv6.
# Possible values: empty for all addresses; 127.0.0.1 for this machine alone, behind a reverse
# proxy or for a monitor on the host; or one of the host's own addresses, such as 192.0.2.3, for
# that network alone.
KNIGHTWATCHER_SERVER_ADDRESS=

# The host port to publish it on. Optional: left out, it is 8080.
# Possible values: a TCP port number from 1 to 65535 that nothing else on the host uses, such as
# 8080.
KNIGHTWATCHER_SERVER_PORT=8080

# The admin page's password. The admin page, at /admin on the server, changes what the collector
# watches: its sources, thresholds and devices. Passed to the server alone, and never shown
# or logged. Left empty, or shorter than 12 characters, the admin page stays off and says why; the
# walls work as before. After a change, run docker compose up -d, which signs every browser out.
# Possible values: empty to leave the admin page off, or a password of at least 12 characters of
# your own, such as a-long-password-of-your-own (in single quotes if it holds $, #, a space or a
# quote).
KNIGHTWATCHER_ADMIN_PASSWORD=

# ---- Credentials -----------------------------------------------------------------------------
# Passed to the collector alone. A source that is not in config.toml needs none of its own, and
# its variables may be left empty or out. A source whose table sets `secret` reads
# KNIGHTWATCHER_<SECRET>_<FIELD> instead, in capitals: secret = "sonarr_4k" reads
# KNIGHTWATCHER_SONARR_4K_API_KEY. A provider file of your own reads KNIGHTWATCHER_<ID>_<FIELD>
# the same way. The container gets only the variables compose names, so such a name must also be
# added to the collector's environment in compose.override.yaml beside compose.yaml, which docker
# compose reads by itself (docs/configuration.md shows how). `python -m collector --check-config`
# names any credential it needs and cannot find, never its value.

# Tautulli's API key, for [sources.streams].
# Where to find it: in Tautulli, Settings, Web Interface, API, with "Enable API" ticked.
# Possible values: 32 hexadecimal characters, such as 0123456789abcdef0123456789abcdef.
KNIGHTWATCHER_TAUTULLI_API_KEY=0123456789abcdef0123456789abcdef

# The Plex token of the server's owner, for [sources.streams] with from = "plex". Plex lists every
# stream to its owner alone. Where to find it: in Plex Web, signed in as the owner, any library
# item's menu, Get Info, View XML; the X-Plex-Token at the end of the address it opens. It is sent
# in the X-Plex-Token header, never in the address, and the collector pauses for 20 minutes after
# any refusal. A Plex token reaches the owner's whole account: keep it as you would the password.
# Possible values: a Plex token, such as AbCdEfGhIjKlMnOpQrSt.
KNIGHTWATCHER_PLEX_TOKEN=AbCdEfGhIjKlMnOpQrSt

# Tracearr's public API key, for [sources.streams] with from = "tracearr" (Tracearr 2.0 or later).
# Where to make it: in Tracearr, signed in as the owner, Settings, Data & API, API, Generate Key.
# It is sent in the Authorization header as a bearer token, never in the address, and the
# collector pauses for 20 minutes after any refusal. The key reads all of Tracearr's data and can
# stop a stream: keep it as you would the password. Tracearr keeps one key, and Regenerate ends the
# old one for whatever else uses it.
# Possible values: trr_pub_ and 43 letters, digits, - and _, such as
# trr_pub_AbCdEfGhIjKlMnOpQrStUvWxYz0123456789-_AbCdE.
KNIGHTWATCHER_TRACEARR_API_KEY=trr_pub_AbCdEfGhIjKlMnOpQrStUvWxYz0123456789-_AbCdE

# An AdGuard Home login, for [sources.adblock]. AdGuard Home has no API keys, so the collector
# signs in as a user of its web interface; a login of its own is best. AdGuard Home locks an
# address out for 15 minutes after five bad logins, and the collector pauses for 20 minutes
# after any refusal.
# Possible values: the user name and the password of that login, such as knightwatcher and
# 'an-invented-password'.
KNIGHTWATCHER_ADGUARD_USERNAME=knightwatcher
KNIGHTWATCHER_ADGUARD_PASSWORD='an-invented-password'

# A Pi-hole 6 password, for [sources.adblock] with from = "pihole". An app password is best: in
# Pi-hole, Settings, Web interface / API, Configure app password. The web password works too, but
# not with two-factor authentication on. The collector logs in once and keeps one session, and
# pauses for 20 minutes after any refusal. Version 5 is not supported.
# Possible values: the password, such as 'an-invented-app-password'.
KNIGHTWATCHER_PIHOLE_PASSWORD='an-invented-app-password'

# A Technitium DNS Server API token, for [sources.adblock] with from = "technitium". Make a user
# of its own in Technitium, in no group but Everyone, which can view but change nothing; sign in
# as that user, then the user menu, Create API Token. The token does not expire. It goes in the
# Authorization header, which needs Technitium 15 or later, and the collector pauses for 20
# minutes after any refusal.
# Possible values: 64 hexadecimal characters, such as
# 0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef.
KNIGHTWATCHER_TECHNITIUM_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Sonarr's API key, for [sources.sonarr].
# Where to find it: in Sonarr, Settings, General, Security, API Key.
# Possible values: 32 hexadecimal characters, such as fedcba9876543210fedcba9876543210.
KNIGHTWATCHER_SONARR_API_KEY=fedcba9876543210fedcba9876543210

# Radarr's API key, for [sources.radarr].
# Where to find it: in Radarr, Settings, General, Security, API Key.
# Possible values: 32 hexadecimal characters, such as 00112233445566778899aabbccddeeff.
KNIGHTWATCHER_RADARR_API_KEY=00112233445566778899aabbccddeeff

# Lidarr's API key, for [sources.lidarr].
# Where to find it: in Lidarr, Settings, General, Security, API Key.
# Possible values: 32 hexadecimal characters, such as 0f1e2d3c4b5a69780f1e2d3c4b5a6978.
KNIGHTWATCHER_LIDARR_API_KEY=0f1e2d3c4b5a69780f1e2d3c4b5a6978
