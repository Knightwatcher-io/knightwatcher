# Knightwatcher: the host paths and the credentials. Copy to .env beside compose.yaml (ignored by
# git), fill in your own, and keep it to yourself: chmod 600 .env. Every value here is invented.
# docs/configuration.md describes each variable.
#
# One NAME=value a line, read by docker compose. A value holding $, #, a space or a quote goes in
# single quotes, such as 'pa$$ word#1', so that compose takes it exactly as written. Settings go
# in config.toml, never here.

# ---- Host paths ------------------------------------------------------------------------------
# compose.yaml mounts each into the collector's container. Every path must already exist.

# The folder state.json is written to: one the web server serves, beside the page. Mounted at
# /out. Must be writable by the collector's account (uid 10001). Required.
# Possible values: an absolute folder, such as /srv/www/knightwatcher/data.
KNIGHTWATCHER_OUT=/srv/www/knightwatcher/data

# The host's backup log, a single file, for [sources.backup]. Mounted read-only at
# /host/backup.log. Required.
# Possible values: an absolute file, such as /var/log/backup.log.
KNIGHTWATCHER_BACKUP_LOG=/var/log/backup.log

# Any folder on the data volume, so that [sources.host] can see the volume's size. Mounted
# read-only at /host/disks/data. An empty folder shares nothing but the size. Required.
# Possible values: an absolute folder, such as /data/lost+found.
KNIGHTWATCHER_DATA_DISK=/data/lost+found

# The folder for the collector's memory between restarts. Mounted at /var/lib/knightwatcher.
# Must be writable by the collector's account. Optional: left out, it is ./var beside
# compose.yaml.
# Possible values: a folder, absolute or relative to compose.yaml, such as ./var.
KNIGHTWATCHER_VAR=./var

# ---- Credentials -----------------------------------------------------------------------------
# Passed to the collector alone. A source that is not in config.toml needs none of its own, and
# its variables may be left empty or out. A source whose table sets `secret` reads
# KNIGHTWATCHER_<SECRET>_<FIELD> instead, in capitals: secret = "sonarr_4k" reads
# KNIGHTWATCHER_SONARR_4K_API_KEY, and that name must then be added to the environment list in
# compose.yaml as well. `python -m collector --check-config` names any credential it needs and
# cannot find, never its value.

# Tautulli's API key, for [sources.streams].
# Where to find it: in Tautulli, Settings, Web Interface, API, with "Enable API" ticked.
# Possible values: 32 hexadecimal characters, such as 0123456789abcdef0123456789abcdef.
KNIGHTWATCHER_TAUTULLI_API_KEY=0123456789abcdef0123456789abcdef

# An AdGuard Home login, for [sources.adblock]. AdGuard Home has no API keys, so the collector
# signs in as a user of its web interface; a login of its own is best. AdGuard Home locks an
# address out for 15 minutes after five bad logins, and the collector pauses for 20 minutes
# after any refusal.
# Possible values: the user name and the password of that login, such as knightwatcher and
# 'an-invented-password'.
KNIGHTWATCHER_ADGUARD_USERNAME=knightwatcher
KNIGHTWATCHER_ADGUARD_PASSWORD='an-invented-password'

# Sonarr's API key, for [sources.sonarr].
# Where to find it: in Sonarr, Settings, General, Security, API Key.
# Possible values: 32 hexadecimal characters, such as fedcba9876543210fedcba9876543210.
KNIGHTWATCHER_SONARR_API_KEY=fedcba9876543210fedcba9876543210

# Radarr's API key, for [sources.radarr].
# Where to find it: in Radarr, Settings, General, Security, API Key.
# Possible values: 32 hexadecimal characters, such as 00112233445566778899aabbccddeeff.
KNIGHTWATCHER_RADARR_API_KEY=00112233445566778899aabbccddeeff
