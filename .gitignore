# Site configuration and credentials: never committed
/config.toml
/secrets.json
# A host's own additions to compose.yaml, such as the credentials of its own provider files
/compose.override.yaml
# Provider files of the user's own: the folder ships empty
/providers/*
!/providers/.gitkeep
.env
.env.*
!.env.example

# What the collector writes for the page
/web/data/

# Python and tooling
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
dist/

# The list of private patterns names what it protects
/tools/private-patterns.txt

# The collector's memory between restarts, and lock files of tools run here
/var/
uv.lock
