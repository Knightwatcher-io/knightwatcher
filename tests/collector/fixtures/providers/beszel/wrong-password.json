{
 "about": "A wrong email or password: PocketBase answers 400, which [auth] refused makes refused credentials, with the pause.",
 "settings": {},
 "credentials": [
  "username",
  "password"
 ],
 "exchanges": [
  {
   "request": {
    "method": "POST",
    "path": "/api/collections/users/auth-with-password",
    "headers": {
     "Content-Type": "application/json"
    },
    "json": {
     "identity": "{credential.username}",
     "password": "{credential.password}"
    }
   },
   "reply": {
    "status": 400,
    "json": {
     "data": {},
     "message": "Failed to authenticate.",
     "status": 400
    }
   }
  }
 ],
 "error": {
  "auth": true,
  "message": "Beszel refused the email or password"
 }
}
