{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knightwatcher-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",

  // Off, so no invocation log is kept. A log of each request would hold what the request
  // carried, the connecting address among it, and the Worker itself logs nothing.
  "observability": {
    "enabled": false
  },

  // Reached at this hostname alone: no workers.dev address and no preview addresses, so
  // blocking the one name stops every heartbeat.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "telemetry.knightwatcher.io",
      "custom_domain": true
    }
  ],

  // The same database is bound to the private dashboard Worker, which reads it. This Worker
  // only writes.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "knightwatcher-telemetry",
      "database_id": "1ecebb52-f2f4-4484-9292-ad35fa6b8103"
    }
  ],

  // A flood guard alone. An install sends four heartbeats a day, and one an hour while failing,
  // so 20 a minute from one address is far above real use, with room for several installs
  // behind one address. The key is the connecting address and nothing else. The namespace id
  // must not be one another Worker in the same Cloudflare account uses, or the two share
  // counts.
  "ratelimits": [
    {
      "name": "HEARTBEAT_LIMITER",
      "namespace_id": "2",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],

  // No scheduled work: no row is ever deleted. Explicit, so a deploy clears any trigger set
  // by hand in the dashboard.
  "triggers": {
    "crons": []
  }
}
